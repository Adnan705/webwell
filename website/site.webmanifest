{
  "name": "WebWell",
  "short_name": "WebWell",
  "description": "A free Chrome and Brave extension: a calm new tab with music, focus sessions, site blocking and private screen-time tracking.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#fbfaf9",
  "theme_color": "#fbfaf9",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
