{
 "action": {
  "default_icon": {
   "128": "icons/icon128.png",
   "16": "icons/icon16.png",
   "48": "icons/icon48.png"
  },
  "default_popup": "popup/popup.html",
  "default_title": "WebWell â€” today's browsing"
 },
 "author": "Written & Developed by Adnan",
 "background": {
  "service_worker": "background.js"
 },
 "description": "A calm new tab with focus timer, music, site blocking and private screen-time tracking. Your data stays on your device.",
 "host_permissions": [
  "https://generativelanguage.googleapis.com/*",
  "https://*.soundcloud.com/*",
  "https://*.sndcdn.com/*",
  "https://open.spotify.com/*"
 ],
 "optional_host_permissions": [
  "<all_urls>"
 ],
 "icons": {
  "128": "icons/icon128.png",
  "16": "icons/icon16.png",
  "48": "icons/icon48.png"
 },
 "manifest_version": 3,
 "minimum_chrome_version": "114",
 "name": "WebWell â€” Daily Browser Monitor",
 "options_page": "dashboard/dashboard.html",
 "permissions": [
  "tabs",
  "storage",
  "idle",
  "alarms",
  "notifications",
  "offscreen",
  "favicon",
  "declarativeNetRequest",
  "scripting",
  "webNavigation",
  "search"
 ],
 "declarative_net_request": {
  "rule_resources": [
   {
    "id": "adult",
    "enabled": false,
    "path": "rules/adult.json"
   }
  ]
 },
 "short_name": "WebWell",
 "version": "1.7.2",
 "chrome_url_overrides": {
  "newtab": "newtab/newtab.html"
 },
 "web_accessible_resources": [
  {
   "resources": [
    "blocked/blocked.html",
    "blocked/pause.html"
   ],
   "matches": [
    "<all_urls>"
   ]
  }
 ]
}
