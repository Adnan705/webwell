{
 "action": {
  "default_icon": {
   "128": "icons/icon128.png",
   "16": "icons/icon16.png",
   "48": "icons/icon48.png"
  },
  "default_popup": "popup/popup.html",
  "default_title": "WebWell \u2014 today's browsing"
 },
 "author": "Written & Developed by Adnan",
 "background": {
  "service_worker": "background.js"
 },
 "description": "Your Digital Wellbeing for the desktop: see which websites take your time, score your productivity, and get warned about your biggest time sinks. Your browsing data stays 100% local \u2014 only features you turn on (AI chat, SoundCloud/radio) use the network.",
 "host_permissions": [
  "https://generativelanguage.googleapis.com/*",
  "https://*.soundcloud.com/*",
  "https://*.sndcdn.com/*"
 ],
 "icons": {
  "128": "icons/icon128.png",
  "16": "icons/icon16.png",
  "48": "icons/icon48.png"
 },
 "manifest_version": 3,
 "minimum_chrome_version": "114",
 "name": "WebWell \u2014 Daily Browser Monitor",
 "options_page": "dashboard/dashboard.html",
 "permissions": [
  "tabs",
  "storage",
  "idle",
  "alarms",
  "notifications",
  "offscreen",
  "favicon"
 ],
 "short_name": "WebWell",
 "version": "1.6.60",
 "chrome_url_overrides": {
  "newtab": "newtab/newtab.html"
 },
 "web_accessible_resources": []
}